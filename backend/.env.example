# ---- Django ----
# Generate a fresh one for real .env: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated list of frontend origins allowed to call this API (CORS).
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# The website's address. Zerodha login redirects that hit the backend are sent here.
FRONTEND_URL=http://localhost:5173

# ---- Database (read by Django via django-environ) ----
# Host is the docker-compose service name, not localhost.
POSTGRES_DB=core
POSTGRES_USER=core
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---- Superuser bootstrap (optional, used by start.sh later) ----
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me

# ---- Redis / Celery / Channels ----
# Host is the docker-compose service name, not localhost.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TIMEZONE=Asia/Kolkata

# ---- Email (alerts) ----
# DEV: leave EMAIL_BACKEND unset/blank -> alerts print to the worker/web logs.
# REAL email via Gmail SMTP:
#   1. Enable 2-Step Verification on the Google account.
#   2. Create an App Password: https://myaccount.google.com/apppasswords
#      (16 chars, e.g. "abcd efgh ijkl mnop" -> paste WITHOUT spaces).
#   3. Uncomment EMAIL_BACKEND and fill the values below.
#   4. Verify with the "Send test email" button on the Settings page.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-address@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=your-address@gmail.com
# Who receives alerts is set on the web UI's Settings page.

# ---- Copy trading ----
# Copy mode (off / dry run / live), alert email recipients and all accounts are
# managed from the web UI, not here.
#
# Key that encrypts broker API secrets / access tokens in the database.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave blank to derive it from DJANGO_SECRET_KEY. If this key changes, re-enter
# each account's API secret and log in to Zerodha again.
FIELD_ENCRYPTION_KEY=
# Retry a copy order this many times on transient (network/5xx) failures.
COPYTRADING_COPY_MAX_RETRIES=3
# Once the master's order has filled, seconds a copy may wait at its own price
# before the rest is cancelled and filled at MARKET.
COPYTRADING_FILL_GRACE_SECONDS=15
# Re-email the same unresolved alert at most once per this many seconds.
COPYTRADING_ALERT_EMAIL_COOLDOWN=900
# Testing only: run the loops outside market hours.
COPYTRADING_FORCE_MARKET_OPEN=False

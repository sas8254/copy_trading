# ---- Django ----
# Generate a fresh one for real .env: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated list of frontend origins allowed to call this API (CORS).
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Database (read by Django via django-environ) ----
# Host is the docker-compose service name, not localhost.
POSTGRES_DB=core
POSTGRES_USER=core
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---- Superuser bootstrap (optional, used by start.sh later) ----
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me

# ---- Redis / Celery / Channels ----
# Host is the docker-compose service name, not localhost.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TIMEZONE=Asia/Kolkata

# ---- Email (alerts) ----
# Leave EMAIL_BACKEND unset in dev to print emails to the console.
# For real sends, e.g. Gmail SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=copytrading@localhost
# Comma-separated recipients for mismatch / failure alerts.
ALERT_EMAIL_TO=

# ---- Zerodha Kite Connect (used in the broker step) ----
KITE_API_KEY=
KITE_API_SECRET=

COPYTRADING_LIVE_ORDERS=False

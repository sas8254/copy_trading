# Production settings. Copy to deploy/.env and fill in every <...> value.
# Generate random values with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"                                   (secret key / passwords)
#   python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"         (FIELD_ENCRYPTION_KEY)

# ---- Website address ----
# Your domain, with its DNS A record pointing at this server and ports 80 + 443
# open. Caddy then gets and renews the HTTPS certificate by itself.
# Use ":80" instead if HTTPS is handled in front of this server (e.g. a
# Cloudflare Tunnel), or to try the stack locally at http://localhost.
SITE_ADDRESS=<copytrading.example.com>
DJANGO_ALLOWED_HOSTS=<copytrading.example.com>
DJANGO_CSRF_TRUSTED_ORIGINS=https://<copytrading.example.com>
FRONTEND_URL=https://<copytrading.example.com>
DJANGO_CORS_ALLOWED_ORIGINS=

# ---- Django ----
DJANGO_SECRET_KEY=<random>

# ---- Database (private to the stack) ----
POSTGRES_DB=core
POSTGRES_USER=core
POSTGRES_PASSWORD=<random>
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---- Website login (created by start.sh if missing) ----
DJANGO_SUPERUSER_USERNAME=<you>
DJANGO_SUPERUSER_EMAIL=<you@example.com>
DJANGO_SUPERUSER_PASSWORD=<long random password>

# ---- Redis / Celery (private to the stack) ----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TIMEZONE=Asia/Kolkata

# ---- Email (alerts) ----
# Gmail needs an App Password (https://myaccount.google.com/apppasswords).
# Who receives alerts is set on the website's Settings page.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=<you@gmail.com>
EMAIL_HOST_PASSWORD=<16-char app password>
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=<you@gmail.com>

# ---- Copy trading ----
# Encrypts broker API secrets in the database. Never change or lose it.
FIELD_ENCRYPTION_KEY=<random 32-byte base64>
# Dead-man's switch: a ping URL from a free healthchecks.io check (period 1 min,
# grace 2-3 min). It emails you if the copy engine stops. Strongly recommended.
HEARTBEAT_URL=
COPYTRADING_FILL_GRACE_SECONDS=15
COPYTRADING_COPY_MAX_RETRIES=3
COPYTRADING_ALERT_EMAIL_COOLDOWN=900
COPYTRADING_FORCE_MARKET_OPEN=False

# ---- Backups ----
# Daily database dumps in deploy/backups/, kept this many days. Copy them off
# the server too (see README).
BACKUP_KEEP_DAYS=14

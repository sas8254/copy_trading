# SITE_ADDRESS is your domain (automatic HTTPS via Let's Encrypt), or ":80"
# when HTTPS is handled in front of this server / for a local trial.
{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	route {
		# Django admin is not public. Use it over an SSH tunnel to 127.0.0.1:8000
		# (see docker-compose.yml).
		respond /admin* 404

		# API and live updates (WebSocket) go to Django.
		reverse_proxy /api/* web:8000
		reverse_proxy /ws/* web:8000

		# The Vue website. Hashed assets are cached for a year; any other path
		# falls back to index.html so the Vue router handles it.
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

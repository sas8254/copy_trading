# ---- Django (prod) ----
DJANGO_SECRET_KEY=change-me-to-a-long-random-string-different-from-dev
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
# Origins allowed for CSRF-protected requests (admin login, etc.)
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
# CORS not needed in prod (same-origin via nginx) — leave empty.
DJANGO_CORS_ALLOWED_ORIGINS=

# ---- Database (prod) ----
POSTGRES_DB=core
POSTGRES_USER=core
POSTGRES_PASSWORD=change-me-prod
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---- Superuser bootstrap ----
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me-prod
